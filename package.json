{
  "name": "fastfile",
  "type": "module",
  "version": "0.0.20",
  "description": "fast cached read write of big binary files",
  "main": "./build/node/main.cjs",
  "module": "./src/fastfile.js",
  "exports": {
    ".": {
      "node": {
        "import": "./src/fastfile.js",
        "require": "./build/node/main.cjs"
      },
      "browser": {
        "import": "./build/browser/browser.esm.js",
        "default": "./build/browser/browser.iife.js"
      },
      "default": "./src/fastfile.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run build && npm run lint",
    "test": "vitest run",
    "test:node": "vitest run --project node-esm --project node-cjs",
    "test:browser": "vitest run --project browser-esm",
    "test:watch": "vitest",
    "test:integration": "vitest run test/test.js --testTimeout=1000000000",
    "build:node": "vite build --mode node",
    "build:browser": "vite build --mode browser",
    "build": "npm run build:node && npm run build:browser"
  },
  "keywords": [
    "file",
    "io",
    "large",
    "binary",
    "cache",
    "random"
  ],
  "author": "0kims",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iden3/fastfile.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^10.1.0",
    "ffjavascript": "git+https://github.com/iden3/ffjavascript.git#cc88563e1686646616ad0fcfafa6cb09c879dd25",
    "globals": "^17.4.0",
    "playwright": "^1.59.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "minimatch": "^3.1.4",
    "postcss": "^8.5.26",
    "brace-expansion": "^5.0.9"
  }
}
